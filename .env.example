# Copie para .env na raiz. Nunca versione credenciais reais.
DB_HOST=mysql
DB_PORT=3306
DB_NAME=mtg4fun
DB_USER=mtg4fun
DB_PASSWORD=troque-esta-senha-local
MYSQL_ROOT_PASSWORD=troque-esta-senha-root-local
# Porta publicada no host; dentro do Docker o MySQL usa DB_PORT=3306.
MYSQL_PORT=3307
PORT=8080
BIND_ADDR=127.0.0.1
COOKIE_SECURE=false
DB_TLS=false
# Caminho dentro do container, se o banco externo exigir uma CA própria.
DB_TLS_CA=
DB_CONNECT_TIMEOUT=120s
