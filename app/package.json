{
  "name": "mtg4fun-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "test": "playwright test",
    "capture:parity-v2": "npm run build && playwright test tests/e2e/paridade-visual-v2.spec.ts --project=desktop --workers=1",
    "test:unit": "node --experimental-strip-types --test src/features/rooms/*.test.ts"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
